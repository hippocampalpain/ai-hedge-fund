# Copy to ~/.hedge-fund/.env (or a .env in your working directory). The app
# also prompts for missing keys on first run and writes them there for you.
# Keys exported in your shell always win over these files.

# For getting financial data to power the hedge fund
# Get your Financial Datasets API key from https://financialdatasets.ai/
FINANCIAL_DATASETS_API_KEY=your-financial-datasets-api-key

# Or pay per call with x402 from a Base wallet that holds USDC, no API key
# needed. Use a small, separate wallet. x402 serves the last 365 days of
# data, for non-professional use. Needs: pip install 'aihf[x402]'
# If both are set, the API key is used. See https://docs.financialdatasets.ai/x402
X402_WALLET_PRIVATE_KEY=0x-your-wallet-private-key

# One LLM API key is enough — set the provider you plan to use.

# For running LLMs hosted by Anthropic (Opus, Sonnet, Haiku)
# Get your Anthropic API key from https://anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key

# For running LLMs hosted by OpenAI (GPT 5, etc.)
# Get your OpenAI API key from https://platform.openai.com/
OPENAI_API_KEY=your-openai-api-key

# For running LLMs hosted by DeepSeek (deepseek-chat, deepseek-reasoner)
# Get your DeepSeek API key from https://deepseek.com/
DEEPSEEK_API_KEY=your-deepseek-api-key

# For running LLMs hosted by Google (gemini-2.5-flash, gemini-2.5-pro)
# Get your Google API key from https://ai.dev/
GOOGLE_API_KEY=your-google-api-key

# For typed investor assessments with Jev — TypeSafe
# Get your TypeSafe API key from https://console.typesafe.ai/
# Select Jev in the model picker, or pass --model jev-1.13.0.
TYPESAFE_API_KEY=your-typesafe-api-key

# For running LLMs hosted by xAI (Grok 4, etc.)
XAI_API_KEY=your-xai-api-key

# For running LLMs hosted by Moonshot / Kimi (kimi-k2, kimi-latest)
# Get your Moonshot API key from https://platform.moonshot.ai/
# Mainland China users: set MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
MOONSHOT_API_KEY=your-moonshot-api-key

# ---------------------------------------------------------------------------
# 한국 모드 (KOSPI/KOSDAQ, 무료 데이터) — 자세한 내용은 README_KR.md / docs/korea_mode/
# ---------------------------------------------------------------------------
# kr 로 두면 한국 모드, 지우거나 비워 두면 원래 미국 모드
# DATA_PROVIDER=kr

# OpenDART 인증키 (무료): https://opendart.fss.or.kr 에서 회원가입 후 발급, 40자리
# DART_API_KEY=your-dart-api-key

# KRX 정보데이터시스템(data.krx.co.kr) 무료 회원 ID/비밀번호 — pykrx가 시세를 받을 때 사용
# 없으면 FinanceDataReader로 대체합니다. 값은 화면이나 로그에 출력되지 않습니다.
# KRX_ID=your-krx-id
# KRX_PW=your-krx-password

# Gemini (위의 GOOGLE_API_KEY를 그대로 사용). 프로그램 기본값은 gemini-flash-latest 이지만
# 무료로 쓸 때는 하루 한도가 더 넉넉한 flash-lite 를 권장합니다 (README_KR.md 참고).
# HEDGE_FUND_LLM_MODEL=gemini-flash-lite-latest

# Gemini 무료 사용량 보호 (기본값)
# LLM_MAX_CONCURRENCY=1
# LLM_MAX_RETRIES=6               # 429 재시도
# LLM_TRANSIENT_RETRIES=3         # 500/502/503/504·Deadline expired·타임아웃 재시도
# LLM_RETRY_BASE_SECONDS=5
# LLM_RETRY_MAX_SECONDS=120
# LLM_MAX_RETRY_HINT_SECONDS=60   # 서버가 이보다 오래 기다리라고 하면 재시도 없이 기권
# GEMINI_TIMEOUT_SECONDS=180
# DART_MIN_INTERVAL=0.3
